{
  "id": "gridlock_suggestion_limit",
  "name": "GridLock suggestion requests",
  "description": "Public demo: 12 suggestion requests per minute per IP.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        {
          "type": "path",
          "op": "re",
          "value": "^/api/pair-recommendation/?$"
        }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 60,
        "limit": 12,
        "keys": [
          "ip"
        ],
        "action": "rate_limit"
      }
    }
  }
}
