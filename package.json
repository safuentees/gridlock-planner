{
  "name": "gridlock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"server/**/*.ts\" \"api/**/*.ts\" index.html vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"server/**/*.ts\" \"api/**/*.ts\" index.html vite.config.ts",
    "bench:spatial": "node --import tsx scripts/benchmark-spatial.ts",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "geokdbush": "2.1.0",
    "kdbush": "4.1.0",
    "leaflet": "1.9.4",
    "leaflet.heat": "0.2.0",
    "lucide-react": "^0.468.0",
    "motion": "12.35.0",
    "papaparse": "5.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "9.3.10",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet.heat": "^0.2.4",
    "@types/node": "^24.0.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
